# NEXUS Omega configuration. Copy this file to `.env` and edit.
#
# EVERYTHING HERE IS OPTIONAL. With no .env at all the system runs fully
# offline: a deterministic rule extractor compiles knowledge and a hashing
# embedder powers retrieval. Add a provider key to switch the semantic
# compiler to an LLM; nothing else changes.
#
# All settings are namespaced NEXUS_* so they cannot be hijacked by an
# unrelated variable already in your shell. The two provider keys are the
# exception -- they also accept the plain names you probably already have set.


# ===== semantic compiler =====================================================

# auto (default) picks the first provider with a usable key, else offline.
# Force it with: openai | anthropic | offline
NEXUS_LLM_PROVIDER=auto

# Either name works for these two:
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# NEXUS_OPENAI_MODEL=gpt-4o-mini
# NEXUS_ANTHROPIC_MODEL=claude-sonnet-5


# ===== embeddings ============================================================
# Only used when an OpenAI key is present; offline uses a 384-dim hashing
# embedder. Changing the dimension rebuilds the vector index automatically.

# NEXUS_EMBEDDING_MODEL=text-embedding-3-small
# NEXUS_EMBEDDING_DIM=1536


# ===== server ================================================================
# If you change the port, update `NEXUS_API` for the frontend proxy too
# (see frontend/next.config.mjs).

# NEXUS_HOST=127.0.0.1
# NEXUS_PORT=8000
# NEXUS_CORS_ORIGINS=["http://localhost:3000"]


# ===== filesystem ============================================================
# Where sources are watched, and where state and the Markdown vault are kept.

# NEXUS_INCOMING_DIR=./incoming_files
# NEXUS_VAULT_DIR=./vault
# NEXUS_DATA_DIR=./data


# ===== ingestion tuning ======================================================
# debounce: seconds of quiet before a changed file is ingested. Raise it if
#   your editor writes in bursts; lower it for a snappier live demo.
# chunk sizes: characters per semantic chunk handed to the extractor.

# NEXUS_DEBOUNCE_SECONDS=1.2
# NEXUS_MAX_CHUNK_CHARS=2400
# NEXUS_MIN_CHUNK_CHARS=180


# ===== reasoning tuning ======================================================
# impact_max_depth:  how many hops a change is traced through.
# impact_min_score:  propagation paths weaker than this are pruned as noise.
# entity_match_threshold:  at or above this, two names are the same entity.
# entity_review_threshold: between the two, a candidate is recorded but a new
#   entity is still created -- a wrong merge is harder to undo than a duplicate.
# contradiction_numeric_tolerance: relative difference below which two numbers
#   are treated as agreeing (0.02 = 2%).

# NEXUS_IMPACT_MAX_DEPTH=6
# NEXUS_IMPACT_MIN_SCORE=0.02
# NEXUS_ENTITY_MATCH_THRESHOLD=0.86
# NEXUS_ENTITY_REVIEW_THRESHOLD=0.72
# NEXUS_CONTRADICTION_NUMERIC_TOLERANCE=0.02
