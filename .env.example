# NEXUS Omega configuration. Copy to .env and fill in what you need.
#
# Everything here is OPTIONAL. With no keys the system runs fully offline:
# the deterministic rule extractor compiles knowledge and a hashing embedder
# powers retrieval. Provide a key to switch the semantic compiler to an LLM.

# --- semantic compiler ---------------------------------------------------
# auto (default) picks the first provider with a usable key, else offline.
NEXUS_LLM_PROVIDER=auto
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# --- server --------------------------------------------------------------
# NEXUS_HOST=127.0.0.1
# NEXUS_PORT=8000

# --- tuning --------------------------------------------------------------
# NEXUS_IMPACT_MAX_DEPTH=6
# NEXUS_CONTRADICTION_NUMERIC_TOLERANCE=0.02
# NEXUS_ENTITY_MATCH_THRESHOLD=0.86
