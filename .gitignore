# runtime state
data/
vault/
incoming_files/*
!incoming_files/.gitkeep

# python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.env

# node
frontend/node_modules/
frontend/.next/
frontend/out/

# build artefacts that should never be committed
frontend/tsconfig.tsbuildinfo
frontend/*.tsbuildinfo

# stray empty lockfile at the repo root (the real one is frontend/package-lock.json)
/package-lock.json
